#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
compose_dir="${repo_root}/infra/compose"
base_file="${compose_dir}/compose.yaml"
test_file="${compose_dir}/compose.test.yaml"
production_file="${compose_dir}/compose.production.yaml"
oss_file="${compose_dir}/compose.oss.yaml"

for required_file in "${base_file}" "${test_file}" "${production_file}" "${oss_file}"; do
  if [[ ! -f "${required_file}" ]]; then
    printf 'missing required Compose file: %s\n' "${required_file}" >&2
    exit 1
  fi
done

command -v docker >/dev/null
command -v curl >/dev/null
command -v python3 >/dev/null

docker compose --project-directory "${compose_dir}" -f "${base_file}" config --quiet
docker compose \
  --project-directory "${compose_dir}" \
  -f "${base_file}" \
  -f "${test_file}" \
  config --quiet
oss_config_file="$(
  mktemp "${TMPDIR:-/tmp}/probeinterview-oss-compose.XXXXXX"
)"
production_config_file="$(
  mktemp "${TMPDIR:-/tmp}/probeinterview-production-compose.XXXXXX"
)"
trap 'rm -f "${oss_config_file}" "${production_config_file}"' EXIT

PROBEINTERVIEW_OSS_ENDPOINT="https://oss-cn-shanghai.aliyuncs.com" \
PROBEINTERVIEW_OSS_BUCKET="probeinterview-test-kb-bucket" \
PROBEINTERVIEW_OSS_ACCESS_KEY_ID="test-access-key" \
PROBEINTERVIEW_OSS_ACCESS_KEY_SECRET="test-access-secret" \
  docker compose \
  --project-directory "${compose_dir}" \
  -f "${base_file}" \
  -f "${oss_file}" \
  config --format json >"${oss_config_file}"

python3 - "${oss_config_file}" <<'PY'
import json
import pathlib
import sys

config = json.loads(pathlib.Path(sys.argv[1]).read_text())
for service_name in ("api", "database-initializer", "worker"):
    environment = config["services"][service_name]["environment"]
    assert environment["PROBEINTERVIEW_OBJECT_STORAGE_ADAPTER"] == "oss"
    assert (
        environment["PROBEINTERVIEW_OSS_ENDPOINT"]
        == "https://oss-cn-shanghai.aliyuncs.com"
    )
    assert environment["PROBEINTERVIEW_OSS_BUCKET"] == "probeinterview-test-kb-bucket"
    assert environment["PROBEINTERVIEW_OSS_ACCESS_KEY_ID"] == "test-access-key"
    assert environment["PROBEINTERVIEW_OSS_ACCESS_KEY_SECRET"] == "test-access-secret"
PY

PROBEINTERVIEW_DOMAIN="probe.example.invalid" \
PROBEINTERVIEW_DATABASE_URL="postgresql+psycopg://probeinterview:test-database-password@postgres:5432/probeinterview" \
PROBEINTERVIEW_CELERY_BROKER_URL="redis://redis:6379/0" \
PROBEINTERVIEW_POSTGRES_PASSWORD="test-database-password" \
PROBEINTERVIEW_WECHAT_APP_ID="test-wechat-app-id" \
PROBEINTERVIEW_WECHAT_APP_SECRET="test-wechat-app-secret" \
PROBEINTERVIEW_OSS_ENDPOINT="https://oss.example.invalid" \
PROBEINTERVIEW_OSS_BUCKET="probeinterview" \
PROBEINTERVIEW_OSS_ACCESS_KEY_ID="test-access-key" \
PROBEINTERVIEW_OSS_ACCESS_KEY_SECRET="test-access-secret" \
PROBEINTERVIEW_BAILIAN_API_KEY="test-bailian-key" \
  docker compose \
  --project-directory "${compose_dir}" \
  -f "${base_file}" \
  -f "${production_file}" \
  config --format json >"${production_config_file}"

python3 - "${production_config_file}" <<'PY'
import json
import pathlib
import sys

config = json.loads(pathlib.Path(sys.argv[1]).read_text())
services = config["services"]
assert set(services) == {
    "api",
    "caddy",
    "database-initializer",
    "postgres",
    "redis",
    "worker",
}

for service_name in ("api", "database-initializer", "postgres", "redis", "worker"):
    assert not services[service_name].get("ports"), service_name

caddy_ports = {
    (port["published"], port["target"], port["protocol"])
    for port in services["caddy"]["ports"]
}
assert ("80", 80, "tcp") in caddy_ports
assert ("443", 443, "tcp") in caddy_ports
assert any(
    volume["source"].endswith("Caddyfile.production")
    and volume["target"] == "/etc/caddy/Caddyfile"
    and volume["read_only"]
    for volume in services["caddy"]["volumes"]
)

expected_backend_environment = {
    "PROBEINTERVIEW_ENVIRONMENT": "production",
    "PROBEINTERVIEW_DATABASE_URL": (
        "postgresql+psycopg://probeinterview:test-database-password"
        "@postgres:5432/probeinterview"
    ),
    "PROBEINTERVIEW_CELERY_BROKER_URL": "redis://redis:6379/0",
    "PROBEINTERVIEW_AUTHENTICATION_MODE": "wechat",
    "PROBEINTERVIEW_WECHAT_ADAPTER": "real",
    "PROBEINTERVIEW_WECHAT_APP_ID": "test-wechat-app-id",
    "PROBEINTERVIEW_WECHAT_APP_SECRET": "test-wechat-app-secret",
    "PROBEINTERVIEW_DEMO_PROFILE_SEED_ENABLED": "false",
    "PROBEINTERVIEW_FOUNDATION_PROBE_ENABLED": "false",
    "PROBEINTERVIEW_OBJECT_STORAGE_ADAPTER": "oss",
    "PROBEINTERVIEW_EMBEDDING_ADAPTER": "bailian",
    "PROBEINTERVIEW_STRUCTURED_LLM_ADAPTER": "bailian",
    "PROBEINTERVIEW_OSS_ENDPOINT": "https://oss.example.invalid",
    "PROBEINTERVIEW_OSS_BUCKET": "probeinterview",
    "PROBEINTERVIEW_OSS_ACCESS_KEY_ID": "test-access-key",
    "PROBEINTERVIEW_OSS_ACCESS_KEY_SECRET": "test-access-secret",
    "PROBEINTERVIEW_BAILIAN_API_KEY": "test-bailian-key",
}
for service_name in ("api", "database-initializer", "worker"):
    environment = services[service_name]["environment"]
    for key, value in expected_backend_environment.items():
        assert environment[key] == value, (service_name, key, environment[key])

for service_name in ("api", "worker"):
    assert (
        services[service_name]["depends_on"]["database-initializer"]["condition"]
        == "service_completed_successfully"
    )
assert (
    services["database-initializer"]["depends_on"]["postgres"]["condition"]
    == "service_healthy"
)

assert (
    services["postgres"]["environment"]["POSTGRES_PASSWORD"]
    == "test-database-password"
)
PY

caddy_image="$(
  python3 - "${production_config_file}" <<'PY'
import json
import pathlib
import sys

config = json.loads(pathlib.Path(sys.argv[1]).read_text())
print(config["services"]["caddy"]["image"])
PY
)"

docker run --rm \
  -v "${compose_dir}/Caddyfile.local:/etc/caddy/Caddyfile:ro" \
  "${caddy_image}" \
  caddy validate --config /etc/caddy/Caddyfile
docker run --rm \
  -e PROBEINTERVIEW_DOMAIN="probe.example.invalid" \
  -v "${compose_dir}/Caddyfile.production:/etc/caddy/Caddyfile:ro" \
  "${caddy_image}" \
  caddy validate --config /etc/caddy/Caddyfile

rm -f "${oss_config_file}" "${production_config_file}"
trap - EXIT

project_name="probeinterview-test-${$}"
test_port="$((20000 + RANDOM % 20000))"
status_file="$(mktemp "${TMPDIR:-/tmp}/probeinterview-compose-status.XXXXXX")"
compose_args=(
  --project-name "${project_name}"
  --project-directory "${compose_dir}"
  -f "${base_file}"
  -f "${test_file}"
)

cleanup() {
  PROBEINTERVIEW_TEST_PORT="${test_port}" docker compose "${compose_args[@]}" \
    down --volumes --remove-orphans >/dev/null 2>&1 || true
  rm -f "${status_file}"
}
trap cleanup EXIT

PROBEINTERVIEW_TEST_PORT="${test_port}" docker compose "${compose_args[@]}" \
  up --build --detach --wait --wait-timeout 180

PROBEINTERVIEW_TEST_PORT="${test_port}" docker compose "${compose_args[@]}" \
  ps --all --format json >"${status_file}"

python3 - "${status_file}" <<'PY'
import json
import pathlib
import sys

raw = pathlib.Path(sys.argv[1]).read_text().strip()
records = json.loads(raw) if raw.startswith("[") else [
    json.loads(line) for line in raw.splitlines() if line
]
expected = {"api", "caddy", "database-initializer", "postgres", "redis", "worker"}
actual = {record["Service"] for record in records}
assert actual == expected, (actual, expected)
unhealthy = {
    record["Service"]: record.get("Health")
    for record in records
    if record["Service"] != "database-initializer"
    and record.get("Health") != "healthy"
}
assert not unhealthy, unhealthy
initializer = next(
    record for record in records if record["Service"] == "database-initializer"
)
assert initializer["State"] == "exited", initializer
assert initializer["ExitCode"] == 0, initializer
PY

curl --fail --silent --show-error \
  "http://127.0.0.1:${test_port}/health/ready" \
  | python3 -c \
    'import json, sys; assert json.load(sys.stdin) == {"status": "ready", "dependencies": {"database": "available", "task_queue": "available"}}'

# Anonymous business requests must hit the protected mount point.
curl --silent --show-error \
  --output /dev/null --write-out '%{http_code}' \
  "http://127.0.0.1:${test_port}/api/v1/me/overview" \
  | python3 -c \
    'import sys; assert sys.stdin.read() == "401", "anonymous overview must be rejected"'

# The demo seed identity binds to the configured fake-adapter app id, so the
# deterministic <openid> login code exchanges directly into a bearer session.
session_file="$(mktemp "${TMPDIR:-/tmp}/probeinterview-compose-session.XXXXXX")"
trap 'rm -f "${session_file}"' EXIT
curl --fail --silent --show-error \
  -H 'Content-Type: application/json' \
  -d '{"code": "oProbeInterviewDemoOpenId01"}' \
  "http://127.0.0.1:${test_port}/api/v1/auth/wechat/exchanges" \
  >"${session_file}"
bearer_token="$(
  python3 - "${session_file}" <<'PY'
import json, pathlib, sys

data = json.loads(pathlib.Path(sys.argv[1]).read_text())
assert data["status"] == "authenticated", data["status"]
assert data["token_type"] == "Bearer"
print(data["access_token"])
PY
)"
rm -f "${session_file}"
trap - EXIT

curl --fail --silent --show-error \
  -H "Authorization: Bearer ${bearer_token}" \
  "http://127.0.0.1:${test_port}/api/v1/me/overview" \
  | python3 -c \
    'import json, sys; data = json.load(sys.stdin); assert data["nickname"] == "Bao"; assert data["current_resume"] is None; assert data["recent_scores"] == []'

for _ in 1 2; do
  curl --fail-with-body --silent --show-error \
    -H "Authorization: Bearer ${bearer_token}" \
    -H "Idempotency-Key: compose-knowledge-source" \
    -F "scope=PRIVATE" \
    -F "file=@${repo_root}/docs/architecture.md;type=text/markdown" \
    "http://127.0.0.1:${test_port}/api/v1/me/knowledge-sources" \
    | python3 -c \
      'import json, sys; data = json.load(sys.stdin); assert data["source"]["scope"] == "PRIVATE"; assert data["source"]["processing_status"] == "PENDING_EXTRACTION"; assert data["quota"]["daily_used"] == 1; assert data["quota"]["effective_source_count"] == 1'
done

curl --fail --silent --show-error \
  -H "Authorization: Bearer ${bearer_token}" \
  "http://127.0.0.1:${test_port}/api/v1/me/knowledge-sources" \
  | python3 -c \
    'import json, sys; data = json.load(sys.stdin); assert len(data["items"]) == 1; assert data["items"][0]["original_filename"] == "architecture.md"; assert data["items"][0]["processing_status"] == "PENDING_EXTRACTION"; assert data["quota"]["daily_used"] == 1'
