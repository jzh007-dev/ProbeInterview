#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
backend_dir="${repo_root}/apps/backend"
container_name="probeinterview-knowledge-source-postgres-${$}"
database_name="probeinterview_knowledge_source_test_${$}"
database_password="probe/interview"

cleanup() {
  docker rm --force --volumes "${container_name}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker run \
  --detach \
  --name "${container_name}" \
  --env "POSTGRES_DB=${database_name}" \
  --env "POSTGRES_PASSWORD=${database_password}" \
  --env POSTGRES_USER=probeinterview \
  --publish "127.0.0.1::5432" \
  pgvector/pgvector:0.8.1-pg17 >/dev/null

host_binding="$(docker port "${container_name}" 5432/tcp)"
host_port="${host_binding##*:}"
database_url="postgresql+psycopg://probeinterview:probe%2Finterview@127.0.0.1:${host_port}/${database_name}"

for _ in {1..60}; do
  if docker exec "${container_name}" \
    pg_isready --username probeinterview --dbname "${database_name}" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

docker exec "${container_name}" \
  pg_isready --username probeinterview --dbname "${database_name}" >/dev/null

cd "${backend_dir}"
PROBEINTERVIEW_DESTRUCTIVE_DATABASE_TEST=1 \
PROBEINTERVIEW_TEST_DATABASE_URL="${database_url}" \
  uv run pytest tests/integration/knowledge_source
