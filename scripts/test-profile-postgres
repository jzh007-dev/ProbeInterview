#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
backend_dir="${repo_root}/apps/backend"
container_name="probeinterview-profile-postgres-${$}"
host_port="$((24000 + RANDOM % 10000))"
database_url="postgresql+psycopg://probeinterview:probeinterview@127.0.0.1:${host_port}/probeinterview"

cleanup() {
  docker rm --force "${container_name}" >/dev/null 2>&1 || true
}
trap cleanup EXIT

docker run \
  --detach \
  --name "${container_name}" \
  --env POSTGRES_DB=probeinterview \
  --env POSTGRES_PASSWORD=probeinterview \
  --env POSTGRES_USER=probeinterview \
  --publish "127.0.0.1:${host_port}:5432" \
  pgvector/pgvector:0.8.1-pg17 >/dev/null

for _ in {1..60}; do
  if docker exec "${container_name}" \
    pg_isready --username probeinterview --dbname probeinterview >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

docker exec "${container_name}" \
  pg_isready --username probeinterview --dbname probeinterview >/dev/null

cd "${backend_dir}"
PROBEINTERVIEW_TEST_DATABASE_URL="${database_url}" \
  uv run pytest tests/integration/profile
