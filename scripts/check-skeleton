#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
backend_source="${repo_root}/apps/backend"
miniprogram_source="${repo_root}/apps/miniprogram"

require_path() {
  local path="$1"
  if [[ ! -e "${path}" ]]; then
    printf 'missing required skeleton path: %s\n' "${path}" >&2
    exit 1
  fi
}

require_path "${backend_source}/pyproject.toml"
require_path "${backend_source}/uv.lock"
require_path "${backend_source}/.env.example"
require_path "${backend_source}/src/probeinterview/__init__.py"
require_path "${backend_source}/src/probeinterview/platform/foundation/domain/__init__.py"
require_path "${backend_source}/src/probeinterview/platform/foundation/application/__init__.py"
require_path "${backend_source}/src/probeinterview/platform/foundation/api/__init__.py"
require_path "${backend_source}/src/probeinterview/platform/foundation/infrastructure/__init__.py"
require_path "${miniprogram_source}/package.json"
require_path "${miniprogram_source}/package-lock.json"
require_path "${miniprogram_source}/tsconfig.json"
require_path "${miniprogram_source}/.node-version"
require_path "${repo_root}/infra/compose"

expected_node_version="$(<"${miniprogram_source}/.node-version")"
actual_node_version="$(node --version)"
actual_node_version="${actual_node_version#v}"
if [[ "${actual_node_version}" != "${expected_node_version}" ]]; then
  printf 'expected Node %s, found %s\n' "${expected_node_version}" "${actual_node_version}" >&2
  exit 1
fi

expected_npm_version="$(
  node -e \
    'const value = require(process.argv[1]).packageManager; process.stdout.write(value.split("@")[1])' \
    "${miniprogram_source}/package.json"
)"
actual_npm_version="$(npm --version)"
if [[ "${actual_npm_version}" != "${expected_npm_version}" ]]; then
  printf 'expected npm %s, found %s\n' "${expected_npm_version}" "${actual_npm_version}" >&2
  exit 1
fi

scratch_dir="$(mktemp -d "${TMPDIR:-/tmp}/probeinterview-skeleton.XXXXXX")"
trap 'rm -rf "${scratch_dir}"' EXIT

mkdir -p "${scratch_dir}/backend" "${scratch_dir}/miniprogram"
cp \
  "${backend_source}/.python-version" \
  "${backend_source}/.env.example" \
  "${backend_source}/pyproject.toml" \
  "${backend_source}/uv.lock" \
  "${scratch_dir}/backend/"
cp -R "${backend_source}/src" "${scratch_dir}/backend/"
cp \
  "${miniprogram_source}/.node-version" \
  "${miniprogram_source}/package.json" \
  "${miniprogram_source}/package-lock.json" \
  "${miniprogram_source}/project.config.json" \
  "${miniprogram_source}/tsconfig.json" \
  "${scratch_dir}/miniprogram/"
cp -R "${miniprogram_source}/miniprogram" "${scratch_dir}/miniprogram/"

UV_PROJECT_ENVIRONMENT="${scratch_dir}/backend/.venv" \
  uv sync --project "${scratch_dir}/backend" --frozen --all-groups
UV_PROJECT_ENVIRONMENT="${scratch_dir}/backend/.venv" \
  PROBEINTERVIEW_DATABASE_URL="postgresql+psycopg://probe@localhost/probe" \
  PROBEINTERVIEW_CELERY_BROKER_URL="redis://localhost:6379/0" \
  PROBEINTERVIEW_AUTHENTICATION_MODE="wechat" \
  PROBEINTERVIEW_WECHAT_ADAPTER="fake" \
  PROBEINTERVIEW_WECHAT_APP_ID="probeinterview-skeleton" \
  uv run --project "${scratch_dir}/backend" --frozen python -c \
  'import probeinterview; from probeinterview.entrypoints.api import create_app; from probeinterview.entrypoints.worker import create_celery_app; assert create_app().title == "ProbeInterview API"; assert create_celery_app().main == "probeinterview"'

(
  cd "${scratch_dir}/miniprogram"
  npm ci --ignore-scripts
  npm run typecheck
)
