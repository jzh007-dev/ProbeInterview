#!/usr/bin/env python3
"""按会话报告上下文与 token 效率，覆盖 Claude Code 与 zcode。

每个会话打印：模型调用次数、累计输入/输出 token、输入:输出 比、平均与峰值上下文、
墙钟时长，以及一个判定。

要盯的指标是 **输入:输出 比**。它与任务大小无关，回答的是"每产出 1 个 token，
我付了多少输入 token"。因为每一轮调用都要重发整个上下文，这个比值就是
往返次数 × 上下文规模的直接体现（见 docs/workflow.md §为什么是这套流程）。

    < 40:1      健康
    40-100:1    上下文偏大，考虑拆会话
    > 100:1     大概率在打转——同一个错误反复试（见 workflow 的两条停手信号）

用法：
    scripts/session-cost                 # 两个来源各显示最近 10 个会话
    scripts/session-cost --last 20
    scripts/session-cost --all
    scripts/session-cost --json          # 机器可读
    scripts/session-cost -v              # 附带每个会话的首条人类提示

只读：不修改任何文件，不发起网络请求。
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
LOCAL_TZ = timezone(timedelta(hours=8))

CLAUDE_ROOT = Path(os.path.expanduser("~/.claude/projects"))
ZCODE_ROOT = Path(os.path.expanduser("~/.zcode/cli/rollout"))

HEALTHY_MAX = 40
WIDE_MAX = 100
MIN_CALLS_FOR_VERDICT = 20


@dataclass
class Session:
    source: str
    session_id: str
    started: datetime | None = None
    ended: datetime | None = None
    calls: int = 0
    input_tokens: int = 0
    output_tokens: int = 0
    peak_context: int = 0
    first_prompt: str | None = None
    tools: dict[str, int] = field(default_factory=dict)

    @property
    def ratio(self) -> float:
        return self.input_tokens / self.output_tokens if self.output_tokens else 0.0

    @property
    def avg_context(self) -> int:
        return round(self.input_tokens / self.calls) if self.calls else 0

    @property
    def minutes(self) -> float:
        if not self.started or not self.ended:
            return 0.0
        return (self.ended - self.started).total_seconds() / 60

    @property
    def verdict(self) -> str:
        if self.calls < MIN_CALLS_FOR_VERDICT:
            return "样本少"
        if self.ratio < HEALTHY_MAX:
            return "ok"
        if self.ratio <= WIDE_MAX:
            return "偏大"
        return "打转"


def _parse_ts(value: str | None) -> datetime | None:
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def _local(dt: datetime | None) -> str:
    return dt.astimezone(LOCAL_TZ).strftime("%m-%d %H:%M") if dt else "-"


def _human_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)


def _first_text(content) -> str | None:
    """从一条消息的 content 里取出第一条可读文本。"""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        for item in content:
            if isinstance(item, dict) and item.get("type") == "text":
                return item.get("text")
    return None


def _is_real_prompt(text: str | None) -> bool:
    if not text:
        return False
    head = text.lstrip()[:300]
    if head.startswith("<"):
        return False
    return "system-reminder" not in head and "continued from a previous" not in head


def _iter_jsonl(path: Path):
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def claude_sessions() -> list[Session]:
    """Claude Code 把项目路径编码成 ~/.claude/projects/-Users-... 目录名。"""
    encoded = str(REPO_ROOT).replace("/", "-")
    project_dir = CLAUDE_ROOT / encoded
    if not project_dir.is_dir():
        return []

    sessions: list[Session] = []
    for path in sorted(project_dir.glob("*.jsonl")):
        session = Session(source="claude", session_id=path.stem[:8])
        for obj in _iter_jsonl(path):
            stamp = _parse_ts(obj.get("timestamp"))
            if stamp:
                session.started = min(session.started, stamp) if session.started else stamp
                session.ended = max(session.ended, stamp) if session.ended else stamp

            kind = obj.get("type")
            if kind == "user" and session.first_prompt is None:
                text = _first_text((obj.get("message") or {}).get("content"))
                if _is_real_prompt(text) and text:
                    session.first_prompt = text.strip().splitlines()[0][:110]

            if kind != "assistant":
                continue
            usage = (obj.get("message") or {}).get("usage") or {}
            context = (
                (usage.get("input_tokens") or 0)
                + (usage.get("cache_read_input_tokens") or 0)
                + (usage.get("cache_creation_input_tokens") or 0)
            )
            output = usage.get("output_tokens") or 0
            if context == 0 and output == 0:
                continue
            session.calls += 1
            session.input_tokens += context
            session.output_tokens += output
            session.peak_context = max(session.peak_context, context)
            for item in (obj.get("message") or {}).get("content") or []:
                if isinstance(item, dict) and item.get("type") == "tool_use":
                    name = item.get("name") or "?"
                    session.tools[name] = session.tools.get(name, 0) + 1

        if session.calls:
            sessions.append(session)
    return sessions


def _zcode_belongs_to_repo(path: Path) -> bool:
    """zcode 的 rollout 文件名里没有项目信息，用文件头做个廉价判断。"""
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            head = handle.read(400_000)
    except OSError:
        return False
    return os.fspath(REPO_ROOT) in head


def zcode_sessions() -> list[Session]:
    if not ZCODE_ROOT.is_dir():
        return []

    sessions: list[Session] = []
    for path in ZCODE_ROOT.glob("*.jsonl"):
        if not _zcode_belongs_to_repo(path):
            continue
        session = Session(source="zcode", session_id=_zcode_id(path))
        for obj in _iter_jsonl(path):
            if obj.get("type") != "model_io":
                continue
            if obj.get("querySource") == "session_title":
                continue
            started = _parse_ts(obj.get("startedAt"))
            ended = _parse_ts(obj.get("completedAt"))
            if started:
                session.started = min(session.started, started) if session.started else started
            if ended:
                session.ended = max(session.ended, ended) if session.ended else ended

            response = obj.get("response") or {}
            usage = response.get("usage") or {}
            # zcode 的顶层 inputTokens 已经包含缓存读取，就是完整上下文。
            context = usage.get("inputTokens") or 0
            output = usage.get("outputTokens") or 0
            if context == 0 and output == 0:
                continue
            session.calls += 1
            session.input_tokens += context
            session.output_tokens += output
            session.peak_context = max(session.peak_context, context)
            for item in response.get("toolCalls") or []:
                name = item.get("name") or "?"
                session.tools[name] = session.tools.get(name, 0) + 1

        if session.calls:
            sessions.append(session)
    return sessions


def _zcode_id(path: Path) -> str:
    stem = path.stem
    if stem.startswith("model-io-sess_"):
        return stem[len("model-io-sess_") :][:8]
    return stem[:8]


def render(sessions: list[Session], verbose: bool) -> None:
    if not sessions:
        print("  (没有找到会话记录)")
        return
    print(f"  {'会话':10} {'起':12} {'调用':>5} {'输入:输出':>10} "
          f"{'平均ctx':>8} {'峰值ctx':>8} {'墙钟':>6}  判定")
    for s in sorted(sessions, key=lambda x: x.started or datetime.min.replace(tzinfo=timezone.utc)):
        ratio = f"{s.ratio:.0f}:1" if s.ratio else "-"
        print(f"  {s.session_id:10} {_local(s.started):12} {s.calls:>5} {ratio:>10} "
              f"{_human_tokens(s.avg_context):>8} {_human_tokens(s.peak_context):>8} "
              f"{s.minutes:>5.0f}分  {s.verdict}")
        if verbose and s.first_prompt:
            print(f"             └ {s.first_prompt}")


def main() -> int:
    parser = argparse.ArgumentParser(
        description="按会话报告 Claude Code / zcode 的 token 效率与上下文健康度。",
    )
    parser.add_argument("--last", type=int, default=10, help="每个来源显示最近 N 个会话（默认 10）")
    parser.add_argument("--all", action="store_true", help="显示全部会话")
    parser.add_argument("--json", action="store_true", help="输出 JSON")
    parser.add_argument("-v", "--verbose", action="store_true", help="附带每个会话的首条提示")
    args = parser.parse_args()

    groups = [
        ("Claude Code", claude_sessions()),
        ("zcode", zcode_sessions()),
    ]
    if not args.all:
        groups = [(name, items[-args.last :]) for name, items in groups]

    if args.json:
        payload = [
            {
                "source": s.source,
                "session": s.session_id,
                "started": s.started.astimezone(LOCAL_TZ).isoformat() if s.started else None,
                "calls": s.calls,
                "input_tokens": s.input_tokens,
                "output_tokens": s.output_tokens,
                "ratio": round(s.ratio, 1),
                "avg_context": s.avg_context,
                "peak_context": s.peak_context,
                "minutes": round(s.minutes, 1),
                "verdict": s.verdict,
            }
            for _, items in groups
            for s in items
        ]
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0

    all_sessions: list[Session] = []
    for name, items in groups:
        label = f"{name} — {REPO_ROOT}" if name == "Claude Code" else f"{name} — 本项目"
        print(f"\n{label}")
        render(items, args.verbose)
        all_sessions.extend(items)

    if all_sessions:
        total_in = sum(s.input_tokens for s in all_sessions)
        total_out = sum(s.output_tokens for s in all_sessions)
        total_calls = sum(s.calls for s in all_sessions)
        ratio = f"{total_in / total_out:.0f}:1" if total_out else "-"
        print(f"\n合计：{len(all_sessions)} 个会话 · {total_calls} 次调用 · "
              f"输入 {_human_tokens(total_in)} · 输出 {_human_tokens(total_out)} · 输入:输出 {ratio}")
        print(f"判定口径：< {HEALTHY_MAX}:1 健康 · {HEALTHY_MAX}-{WIDE_MAX}:1 偏大 · "
              f"> {WIDE_MAX}:1 打转（少于 {MIN_CALLS_FOR_VERDICT} 次调用不给判定）")
    return 0


if __name__ == "__main__":
    sys.exit(main())
