<view class="home-overview">
  <view wx:if="{{status == 'loading'}}" class="state-card loading-state">
    <view class="state-orb"></view>
    <view class="state-title">正在进入登录</view>
    <view class="state-copy">未找到有效的登录信息</view>
  </view>

  <block wx:elif="{{status == 'success' && currentUser}}">
    <view class="page-head">
      <view>
        <view class="head-kicker">{{dateLabel}}</view>
        <view class="page-title">{{greeting}}，{{currentUser.nickname}}</view>
      </view>
      <view
        id="search-knowledge"
        class="round-action"
        data-action="search-knowledge"
        bindtap="handleAction"
      >⌕</view>
    </view>

    <view
      wx:if="{{!currentUser.defaultTargetProfile}}"
      class="profile-hint-card"
    >
      <view class="profile-hint-title">先设置你的目标岗位</view>
      <view class="profile-hint-copy">设置后，训练才能围绕目标岗位展开</view>
      <view id="go-profile" class="profile-hint-action" bindtap="onGoToProfile">
        去设置
      </view>
    </view>

    <view class="week-card">
      <view
        class="coverage-ring"
        style="background: conic-gradient(#64c8c1 0 {{weeklyCoveragePercent}}%, rgba(68, 93, 82, 0.1) {{weeklyCoveragePercent}}% 100%)"
      >
        <view class="coverage-ring-center">{{weeklyCoveragePercent}}%</view>
      </view>
      <view class="week-copy">
        <view class="section-label">本周训练覆盖</view>
        <view class="week-title">已学习 {{coveredTopicCount}} 个主题</view>
        <view class="coverage-dots">
          <view
            wx:for="{{topics}}"
            wx:key="id"
            class="coverage-dot {{item.coveredThisWeek ? 'coverage-dot-covered' : ''}}"
          ></view>
        </view>
      </view>
      <view class="review-pill">待复盘 {{pendingReviewCount}}</view>
    </view>

    <view class="section-head">
      <view class="section-title">继续学习</view>
      <view class="section-meta">{{currentLearningProgress}}</view>
    </view>

    <view class="learning-stack">
      <view class="stack-layer stack-layer-lilac"></view>
      <view class="stack-layer stack-layer-mint"></view>
      <swiper
        id="learning-swiper"
        class="learning-swiper"
        current="{{currentLearningIndex}}"
        duration="260"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{learningCards}}" wx:key="id">
          <view class="learning-card">
            <view class="learning-meta">
              <view class="topic-pill">{{item.topic}}</view>
              <view class="progress-copy">{{item.currentStep}} / {{item.totalSteps}}</view>
            </view>
            <view class="learning-title">{{item.title}}</view>
            <view class="learning-summary">{{item.summary}}</view>
            <view class="learning-footer">
              <view class="progress-track">
                <view
                  class="progress-value"
                  style="width: {{item.progressPercent}}%"
                ></view>
              </view>
              <view
                id="continue-learning-{{index}}"
                class="continue-action"
                data-action="continue-learning"
                bindtap="handleAction"
              >继续学习</view>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="swiper-indicators">
      <view
        wx:for="{{learningCards}}"
        wx:key="id"
        class="swiper-indicator {{index == currentLearningIndex ? 'swiper-indicator-active' : ''}}"
      ></view>
    </view>

    <view class="section-head topic-section-head">
      <view class="section-title">按主题学习</view>
      <view id="selected-topic-summary" class="section-meta">
        {{selectedTopicSummary}}
      </view>
    </view>

    <view class="topic-grid">
      <view
        wx:for="{{topics}}"
        wx:key="id"
        id="topic-{{item.id}}"
        class="topic-card {{item.id == selectedTopicId ? 'topic-card-selected' : ''}}"
        data-topic-id="{{item.id}}"
        bindtap="onSelectTopic"
      >
        <view class="topic-icon" style="background: {{item.surfaceColor}}">
          {{item.icon}}
        </view>
        <view class="topic-copy">
          <view class="topic-name">{{item.name}}</view>
          <view class="topic-description">{{item.description}}</view>
          <view class="topic-count">{{item.knowledgePointCount}} 个知识点</view>
        </view>
      </view>
    </view>
  </block>
</view>
