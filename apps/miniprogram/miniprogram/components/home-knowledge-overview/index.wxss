.home-overview {
  min-height: 100vh;
  padding: 38rpx 30rpx 54rpx;
  box-sizing: border-box;
  color: #334039;
  background:
    radial-gradient(circle at 104% 0%, rgba(229, 245, 154, 0.48), transparent 27%),
    radial-gradient(circle at -6% 64%, rgba(126, 222, 218, 0.22), transparent 30%),
    radial-gradient(circle at 102% 98%, rgba(199, 187, 243, 0.2), transparent 30%),
    linear-gradient(155deg, #f8f8f3, #edf1ee 61%, #f4f0f5);
}

.page-head,
.week-card,
.learning-meta,
.learning-footer,
.section-head {
  display: flex;
  align-items: center;
}

.page-head,
.learning-meta,
.learning-footer,
.section-head {
  justify-content: space-between;
}

.page-head {
  padding: 4rpx 4rpx 0;
  margin-bottom: 30rpx;
}

.head-kicker,
.section-label,
.section-meta,
.progress-copy,
.learning-summary,
.topic-description,
.topic-count,
.state-copy {
  color: #7c8881;
}

.head-kicker {
  font-size: 22rpx;
  letter-spacing: 0.02em;
}

.page-title {
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.18;
}

.round-action {
  width: 88rpx;
  height: 88rpx;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  margin-left: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 24%, rgba(255, 255, 255, 0.92), transparent 35%),
    rgba(255, 255, 255, 0.5);
  box-shadow:
    0 20rpx 44rpx rgba(56, 70, 63, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.86);
  font-size: 34rpx;
}

.week-card {
  min-height: 162rpx;
  padding: 24rpx 25rpx;
  box-sizing: border-box;
  gap: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 94% -10%, rgba(255, 255, 255, 0.82), transparent 32%),
    linear-gradient(142deg, rgba(216, 242, 235, 0.94), rgba(191, 225, 217, 0.8));
  box-shadow:
    0 28rpx 56rpx rgba(67, 114, 105, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
}

.coverage-ring {
  width: 104rpx;
  height: 104rpx;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  box-shadow: 0 18rpx 34rpx rgba(64, 145, 139, 0.13);
}

.coverage-ring-center {
  width: 78rpx;
  height: 78rpx;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(247, 250, 247, 0.92);
  font-size: 22rpx;
  font-weight: 500;
}

.week-copy {
  min-width: 0;
  flex: 1;
}

.section-label,
.progress-copy,
.section-meta,
.topic-count {
  font-size: 20rpx;
}

.week-title {
  margin: 7rpx 0 11rpx;
  font-size: 29rpx;
  font-weight: 500;
}

.coverage-dots {
  display: flex;
  gap: 7rpx;
}

.coverage-dot {
  width: 29rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
}

.coverage-dot-covered {
  background: #75938a;
}

.review-pill {
  padding: 14rpx 17rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 12rpx 24rpx rgba(66, 93, 82, 0.07);
  font-size: 20rpx;
  white-space: nowrap;
}

.section-head {
  margin: 31rpx 6rpx 17rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 500;
}

.learning-stack {
  position: relative;
  height: 296rpx;
}

.stack-layer {
  position: absolute;
  left: 7%;
  right: 7%;
  height: 246rpx;
  border-radius: 49rpx;
}

.stack-layer-lilac {
  top: 0;
  background: rgba(195, 181, 240, 0.78);
  box-shadow: 0 24rpx 48rpx rgba(100, 84, 142, 0.08);
  transform: rotate(-1.4deg);
}

.stack-layer-mint {
  top: 14rpx;
  left: 4%;
  right: 4%;
  background: rgba(117, 217, 214, 0.82);
  box-shadow: 0 24rpx 48rpx rgba(62, 135, 131, 0.09);
  transform: rotate(0.9deg);
}

.learning-swiper {
  position: absolute;
  top: 29rpx;
  width: 100%;
  height: 255rpx;
}

.learning-card {
  min-height: 250rpx;
  padding: 27rpx 29rpx 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.58);
  border-radius: 52rpx;
  background:
    radial-gradient(circle at 94% 0%, rgba(255, 255, 255, 0.68), transparent 31%),
    linear-gradient(145deg, rgba(240, 247, 192, 0.98), rgba(220, 233, 143, 0.95));
  box-shadow:
    0 29rpx 58rpx rgba(87, 105, 65, 0.14),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.topic-pill {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.6);
  font-size: 19rpx;
}

.learning-title {
  margin: 18rpx 0 9rpx;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.28;
}

.learning-summary {
  font-size: 22rpx;
  line-height: 1.48;
}

.learning-footer {
  margin-top: 20rpx;
}

.progress-track {
  width: 190rpx;
  height: 9rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(67, 84, 74, 0.12);
}

.progress-value {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #78cac4, #52645a);
}

.continue-action,
.retry-action {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  color: #f6f9f7;
  background: linear-gradient(145deg, #46564d, #303d36);
  box-shadow: 0 15rpx 30rpx rgba(47, 60, 53, 0.16);
  font-size: 21rpx;
}

.swiper-indicators {
  height: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin-top: 2rpx;
}

.swiper-indicator {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(68, 83, 74, 0.2);
}

.swiper-indicator-active {
  width: 31rpx;
  border-radius: 999rpx;
  background: #4f6258;
}

.topic-section-head {
  align-items: end;
  margin-top: 34rpx;
}

.topic-section-head .section-meta {
  max-width: 58%;
  text-align: right;
}

.topic-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15rpx;
}

.topic-card {
  min-height: 132rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 35rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow:
    0 16rpx 34rpx rgba(56, 72, 63, 0.055),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.76);
}

.topic-card-selected {
  border-color: rgba(109, 143, 128, 0.38);
  background: rgba(225, 242, 235, 0.82);
  box-shadow:
    0 18rpx 38rpx rgba(63, 109, 91, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
}

.topic-icon {
  width: 64rpx;
  height: 64rpx;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 23rpx;
  font-size: 19rpx;
  font-weight: 500;
}

.topic-copy {
  min-width: 0;
  margin-left: 15rpx;
}

.topic-name {
  font-size: 23rpx;
  font-weight: 500;
}

.topic-description {
  margin-top: 5rpx;
  font-size: 18rpx;
  white-space: nowrap;
}

.topic-count {
  margin-top: 5rpx;
}

.state-card {
  padding: 54rpx 38rpx;
  margin-top: 190rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 48rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow:
    0 26rpx 54rpx rgba(56, 72, 63, 0.09),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  text-align: center;
}

.error-state {
  background:
    radial-gradient(circle at 100% 0%, rgba(238, 232, 250, 0.82), transparent 38%),
    rgba(255, 255, 255, 0.66);
}

.state-orb,
.state-symbol {
  width: 62rpx;
  height: 62rpx;
  display: grid;
  place-items: center;
  margin: 0 auto 22rpx;
  border-radius: 50%;
}

.state-orb {
  background: conic-gradient(#79cbc5, #e3ef92, #79cbc5);
  box-shadow: 0 14rpx 28rpx rgba(64, 145, 139, 0.14);
}

.state-symbol {
  color: #ffffff;
  background: linear-gradient(145deg, #8f7bb7, #64567d);
  font-size: 30rpx;
}

.state-title {
  font-size: 29rpx;
  font-weight: 500;
}

.state-copy {
  margin-top: 11rpx;
  font-size: 22rpx;
}

.retry-action {
  width: fit-content;
  margin: 28rpx auto 0;
}
