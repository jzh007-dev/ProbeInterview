.profile-overview {
  min-height: 100vh;
  padding: 38rpx 32rpx 48rpx;
  box-sizing: border-box;
  color: #334039;
  background:
    radial-gradient(circle at 100% 0%, rgba(229, 245, 154, 0.42), transparent 28%),
    radial-gradient(circle at 0% 72%, rgba(135, 226, 224, 0.2), transparent 32%),
    linear-gradient(155deg, #f7f7f2, #edf1ee 62%, #f4f0f5);
}

.page-head,
.profile-card,
.resume-row,
.setting-row {
  display: flex;
  align-items: center;
}

.page-head,
.resume-row,
.setting-row {
  justify-content: space-between;
}

.page-head {
  margin-bottom: 30rpx;
}

.head-kicker,
.section-label,
.section-copy,
.profile-meta,
.state-copy {
  color: #7c8881;
  font-size: 22rpx;
}

.page-title {
  margin-top: 6rpx;
  font-size: 50rpx;
  font-weight: 500;
}

.round-action {
  width: 82rpx;
  height: 82rpx;
  display: grid;
  place-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.48);
  box-shadow: 0 18rpx 40rpx rgba(56, 70, 63, 0.1);
}

.soft-card,
.mint-card,
.state-card,
.setting-row {
  border-radius: 38rpx;
  box-shadow:
    0 22rpx 46rpx rgba(56, 72, 63, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.soft-card,
.state-card,
.setting-row {
  background: rgba(255, 255, 255, 0.6);
}

.profile-card {
  padding: 32rpx;
  margin-bottom: 22rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  display: grid;
  flex: 0 0 auto;
  place-items: center;
  overflow: hidden;
  border-radius: 50%;
  color: #fff;
  background: linear-gradient(145deg, #52645a, #303d36);
  box-shadow: 0 16rpx 36rpx rgba(47, 60, 53, 0.19);
  font-size: 30rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.profile-copy {
  margin-left: 22rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 500;
}

.profile-meta {
  margin-top: 8rpx;
}

.resume-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.62), transparent 34%),
    linear-gradient(145deg, #dff1ea, #bfe3dc);
  box-shadow: 0 24rpx 48rpx rgba(71, 121, 111, 0.13);
}

.target-card {
  padding: 32rpx;
  margin-bottom: 26rpx;
}

.target-summary {
  margin-top: 20rpx;
  display: grid;
  gap: 18rpx;
}

.target-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.target-summary-label {
  color: #7c8881;
  font-size: 24rpx;
}

.target-summary-value {
  font-size: 27rpx;
}

.target-edit {
  width: fit-content;
  padding: 16rpx 30rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  color: #334039;
  border: 1rpx solid rgba(51, 64, 57, 0.24);
  background: rgba(255, 255, 255, 0.7);
  font-size: 25rpx;
}

.target-field {
  margin-top: 28rpx;
}

.target-field-label {
  margin-bottom: 12rpx;
  color: #7c8881;
  font-size: 24rpx;
}

.target-picker-value {
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(51, 64, 57, 0.14);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 27rpx;
  color: #334039;
}

.inline-error {
  margin-top: 20rpx;
  color: #b0574a;
  font-size: 23rpx;
}

.inline-notice {
  margin-top: 20rpx;
  color: #3f7a5f;
  font-size: 23rpx;
}

.target-save {
  width: 100%;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #f6f9f7;
  background: linear-gradient(145deg, #46564d, #303d36);
  font-size: 27rpx;
}

.resume-row {
  margin-top: 12rpx;
}

.resume-name,
.section-title,
.state-title {
  font-size: 28rpx;
  font-weight: 500;
}

.section-copy {
  margin-top: 6rpx;
}

.row-arrow {
  font-size: 36rpx;
}

.history-card {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.empty-copy {
  margin-top: 14rpx;
  color: #66736c;
  font-size: 25rpx;
  line-height: 1.5;
}

.setting-list {
  display: grid;
  gap: 14rpx;
}

.setting-row {
  padding: 26rpx 28rpx;
  font-size: 26rpx;
}

.state-card {
  padding: 48rpx 36rpx;
  margin-top: 180rpx;
  text-align: center;
}

.state-copy {
  margin-top: 12rpx;
}

.retry-action {
  width: fit-content;
  padding: 18rpx 30rpx;
  margin: 28rpx auto 0;
  border-radius: 999rpx;
  color: #f6f9f7;
  background: linear-gradient(145deg, #46564d, #303d36);
}
