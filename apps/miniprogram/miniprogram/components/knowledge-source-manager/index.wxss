.knowledge-source-manager {
  min-height: 100vh;
  padding: 38rpx 32rpx 52rpx;
  box-sizing: border-box;
  color: #334039;
  background:
    radial-gradient(circle at 100% 0%, rgba(229, 245, 154, 0.42), transparent 28%),
    radial-gradient(circle at 0% 72%, rgba(135, 226, 224, 0.2), transparent 32%),
    linear-gradient(155deg, #f7f7f2, #edf1ee 62%, #f4f0f5);
}

.page-head,
.upload-card-head,
.upload-card-head,
.selected-file,
.section-head,
.scope-selector {
  display: flex;
  align-items: center;
}

.page-head,
.section-head {
  justify-content: space-between;
}

.page-head {
  margin-bottom: 28rpx;
}

.head-kicker,
.state-copy,
.quota-copy {
  color: #7c8881;
  font-size: 22rpx;
}

.page-title {
  margin-top: 6rpx;
  font-size: 50rpx;
  font-weight: 500;
}

.upload-card,
.state-card,
.empty-card,
.history-item {
  border-radius: 36rpx;
  box-shadow:
    0 22rpx 46rpx rgba(56, 72, 63, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.upload-card {
  padding: 30rpx;
  background:
    radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.62), transparent 34%),
    linear-gradient(145deg, #dff1ea, #bfe3dc);
}

.upload-icon {
  width: 72rpx;
  height: 72rpx;
  display: grid;
  flex: 0 0 auto;
  margin-right: 20rpx;
  place-items: center;
  border-radius: 24rpx;
  color: #fff;
  background: #46564d;
}

.upload-title,
.section-title,
.state-title,
.selected-name,
.history-name {
  font-size: 28rpx;
  font-weight: 500;
}

.quota-copy {
  margin-top: 24rpx;
}

.quota-warning,
.inline-error {
  margin-top: 14rpx;
  color: #9b4d42;
  font-size: 23rpx;
}

.secondary-action::after,
.primary-action::after {
  border: 0;
}

.secondary-action,
.primary-action {
  margin: 24rpx 0 0;
  border-radius: 999rpx;
  font-size: 25rpx;
}

.secondary-action {
  color: #334039;
  background: rgba(255, 255, 255, 0.65);
}

.primary-action {
  color: #fff;
  background: linear-gradient(145deg, #46564d, #303d36);
}

.selected-file {
  align-items: stretch;
  flex-direction: column;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.52);
}

.scope-selector {
  width: 100%;
  gap: 12rpx;
  margin-top: 20rpx;
}

.scope-option {
  flex: 1;
  padding: 14rpx;
  border: 1rpx solid rgba(51, 64, 57, 0.18);
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
}

.scope-option.selected {
  color: #fff;
  background: #46564d;
}

.section-head {
  margin: 34rpx 4rpx 18rpx;
}

.state-card,
.empty-card {
  padding: 44rpx 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.62);
}

.state-copy {
  margin-top: 8rpx;
  line-height: 1.5;
}

.history-list {
  display: grid;
  gap: 14rpx;
}

.history-item {
  width: 100%;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.66);
}

.history-name {
  min-width: 0;
  flex: 0 1 auto;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.history-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
}

.processing-copy {
  min-width: 0;
  flex: 1;
  color: #65746c;
  font-size: 23rpx;
}

.processing-tag,
.scope-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.processing-tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  color: #665a73;
  background: #ece6f8;
  font-size: 24rpx;
  font-weight: 500;
}

.scope-tag {
  flex: 0 0 auto;
}

.scope-tag.private {
  color: #3d635a;
  background: #d9eeea;
}

.scope-tag.public {
  color: #66532c;
  background: #f0e7bd;
}

.history-time {
  margin-top: 8rpx;
}
