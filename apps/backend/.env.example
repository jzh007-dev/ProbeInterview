PROBEINTERVIEW_ENVIRONMENT=development
PROBEINTERVIEW_DATABASE_URL=postgresql+psycopg://probeinterview:probeinterview@localhost:5432/probeinterview
PROBEINTERVIEW_CELERY_BROKER_URL=redis://localhost:6379/0
PROBEINTERVIEW_AUTHENTICATION_MODE=wechat
PROBEINTERVIEW_WECHAT_ADAPTER=fake
PROBEINTERVIEW_WECHAT_APP_ID=probeinterview-development
PROBEINTERVIEW_DEMO_PROFILE_SEED_ENABLED=true
PROBEINTERVIEW_FOUNDATION_PROBE_ENABLED=true
PROBEINTERVIEW_OBJECT_STORAGE_ADAPTER=fake
# 开发者工具渲染 fake 签名头像用的本地展示基址（host 直跑 API 时改为 http://127.0.0.1:8000）
PROBEINTERVIEW_FAKE_OBJECT_STORAGE_DISPLAY_BASE_URL=http://127.0.0.1:8080
PROBEINTERVIEW_EMBEDDING_ADAPTER=fake
PROBEINTERVIEW_STRUCTURED_LLM_ADAPTER=fake
